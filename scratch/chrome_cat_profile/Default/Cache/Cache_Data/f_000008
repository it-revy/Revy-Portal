able-action-btn-group .action-btn:focus-visible {\r\n  outline: 2px solid var(--accent-primary);\r\n  outline-offset: 1px;\r\n}\r\n\r\n/* Secondary Action: History */\r\n.table-action-btn-group .action-btn-history {\r\n  color: var(--text-secondary);\r\n}\r\n.table-action-btn-group .action-btn-history:hover {\r\n  background: #f1f5f9;\r\n  border-color: #cbd5e1;\r\n  color: var(--text-primary);\r\n}\r\n\r\n/* Primary / Common Action: Edit */\r\n.table-action-btn-group .action-btn-edit {\r\n  color: var(--text-secondary);\r\n}\r\n.table-action-btn-group .action-btn-edit:hover {\r\n  background: #eff6ff;\r\n  border-color: #bfdbfe;\r\n  color: var(--accent-primary);\r\n}\r\n\r\n/* Credentials / Security Action: Password */\r\n.table-action-btn-group .action-btn-password {\r\n  color: #2563eb;\r\n  border-color: rgba(37, 99, 235, 0.22);\r\n}\r\n.table-action-btn-group .action-btn-password:hover {\r\n  background: #eff6ff;\r\n  border-color: #93c5fd;\r\n  color: #1d4ed8;\r\n}\r\n\r\n/* Warning / State Action: Deactivate */\r\n.table-action-btn-group .action-btn-warning {\r\n  color: #d97706;\r\n  border-color: rgba(245, 158, 11, 0.25);\r\n}\r\n.table-action-btn-group .action-btn-warning:hover {\r\n  background: #fffbeb;\r\n  border-color: #fde68a;\r\n  color: #b45309;\r\n}\r\n\r\n/* Destructive / Dangerous Action: Delete */\r\n.table-action-btn-group .action-btn-danger {\r\n  color: #ef4444;\r\n  border-color: rgba(239, 68, 68, 0.25);\r\n}\r\n.table-action-btn-group .action-btn-danger:hover {\r\n  background: #fef2f2;\r\n  border-color: #fecaca;\r\n  color: #dc2626;\r\n}\r\n\r\n/* ========================================================\r\n   RESPONSIVE MODALS & DRAWERS\r\n   ======================================================== */\r\n.modal-overlay {\r\n  position: fixed;\r\n  top: 0; left: 0; right: 0; bottom: 0;\r\n  background: rgba(15, 23, 42, 0.55);\r\n  backdrop-filter: blur(3px);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n 