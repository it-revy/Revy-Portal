# ========================================================
# REVY BREAKFAST MANAGEMENT - BACKEND ENVIRONMENT VARIABLES
# ========================================================

# Database Connection (PostgreSQL with SQLAlchemy)
# Example: postgresql+psycopg2://postgres:postgres@localhost:5432/breakfast_db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/breakfast_db

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://break-fast-management.vercel.app

# Application Timezone
APP_TIMEZONE=Asia/Kolkata

# Server Host & Port
HOST=0.0.0.0
PORT=5000

# Azure Storage Integration (Optional / Future REVY Enterprise Integration)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=revy-breakfast-files

# Microsoft Entra ID / 365 SSO (Optional / Future REVY Centralized SSO)
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=
ENTRA_CLIENT_SECRET=
