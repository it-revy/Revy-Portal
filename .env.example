# ========================================================
# REVY BREAKFAST MANAGEMENT - ROOT ENVIRONMENT TEMPLATE
# ========================================================

# Backend Configuration
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/breakfast_db
JWT_SECRET=super_secure_random_secret_replace_in_production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Azure Integration
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=revy-breakfast-files

# Microsoft Entra ID / Microsoft 365 SSO
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=
ENTRA_CLIENT_SECRET=

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api
VITE_APP_NAME=REVY Breakfast Management
VITE_ENV=development

# Docker Compose Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=breakfast_db
POSTGRES_PORT=5432
BACKEND_PORT=5000
FRONTEND_PORT=5173
